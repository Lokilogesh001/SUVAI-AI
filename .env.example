# ==========================================
# suvAI — Environment Variables Configuration
# ==========================================

# Supabase Configuration
# Obtain these from your Supabase project dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# External Recipe API (Spoonacular)
# Used by RecipeProvider service layer (supports caching and mock fallback)
VITE_SPOONACULAR_API_KEY=your-spoonacular-api-key

# Optional AI Assistant API Key (OpenAI / Gemini / Groq)
# If provided, powers enhanced contextual conversation in the Recipe Assistant
VITE_AI_API_KEY=
